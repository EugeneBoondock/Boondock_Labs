{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "boondock-outreach-registry",
  "account_id": "e31feaa4cca751cc2db46646c505f63b",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-27",
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "OUTREACH_DB",
      "database_name": "boondock-labs-outreach",
      "database_id": "01a355bf-a7fa-48d3-8708-d615397301f7"
    }
  ],
  "vars": {
    "BROWSER_RESEARCH_HOSTS": "live-profiles.com,africabizinfo.com,saonlinedirectory.co.za",
    "OUTREACH_DAILY_LIMIT": "200",
    "OUTREACH_RUN_LIMIT": "50",
    "OUTREACH_MAX_QUOTE_MINOR": "100000000"
  }
}
