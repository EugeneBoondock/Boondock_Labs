[Unit]
Description=Boondock Labs restricted Earthie executor for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=boondock-executor
Group=boondock-executor
WorkingDirectory=/workspace/%i
Environment=HOME=/workspace/%i
EnvironmentFile=/etc/boondock-outreach/executors/%i.env
ExecStart=/usr/local/bin/codex exec-server --remote ${CODEX_REMOTE_URL} --environment-id ${CODEX_ENVIRONMENT_ID}
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/workspace/%i
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
