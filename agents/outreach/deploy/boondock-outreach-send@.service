[Unit]
Description=Boondock Labs guarded prospect send slot %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=boondock-outreach
Group=boondock-outreach
WorkingDirectory=/opt/boondock-outreach/current
EnvironmentFile=/etc/boondock-outreach/outreach.env
Environment=OUTREACH_SCHEDULE_SEND_ENABLED=true
ExecStart=/usr/bin/node /opt/boondock-outreach/current/agents/outreach/scheduled-send.mjs %i
TimeoutStartSec=3h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/boondock-outreach
MemoryMax=512M
